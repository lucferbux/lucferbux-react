{
  "name": "lucferbux-react",
  "type": "module",
  "private": true,
  "description": "Personal Webpage of Lucas Fernandez",
  "version": "2.0.0",
  "author": "Lucas Fernandez <lucasfernandezaragon@gmail.com>",
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-parallax-tilt": "^1.7.349",
    "react-router": "^8.5.0",
    "rehype-prism-plus": "^2.0.2",
    "remark-gfm": "^4.0.1",
    "typewriter-effect": "^3.3.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "react",
    "vite",
    "tailwindcss",
    "firebase",
    "personal-website"
  ],
  "license": "0BSD",
  "scripts": {
    "banners": "node scripts/generate-banners.mjs",
    "banners:upload": "node scripts/upload-banners.mjs",
    "build": "tsc --noEmit && vite build",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage:rules",
    "dev": "vite",
    "dev:fixtures": "VITE_FIXTURE_DATA=1 vite",
    "emulators": "firebase emulators:start --only firestore,auth,storage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "node scripts/seed.mjs",
    "set-admin": "node scripts/set-admin.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "visual": "playwright test",
    "visual:baseline": "playwright test --update-snapshots",
    "visual:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lucferbux/LucferbuxReact"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  },
  "packageManager": "npm@11.8.0+sha512.9f5f6c25e5be44629d907a3c482739c614b090a8505057d9685cd273e12c6172e34aa215d2d97bd9a0d8415bb356f7eb6f2b06c1d690b0d2cdcb9f09d7410149",
  "allowScripts": {
    "protobufjs": false,
    "@firebase/util": false
  }
}
